---
name: openbao
packages:
  - openbao
  - certifier

templates:
  bin/pre-start: bin/pre-start
  config/bpm.yml: config/bpm.yml
  config/openbao.hcl: config/openbao.hcl

  seal/current.key: seal/current.key
  seal/previous.key: seal/previous.key

  tls/vault/cert.pem: tls/vault/cert.pem
  tls/vault/key.pem: tls/vault/key.pem

  tls/peer/ca.pem: tls/peer/ca.pem
  tls/peer/cert.pem: tls/peer/cert.pem
  tls/peer/key.pem: tls/peer/key.pem

  dns/aliases.json.erb: dns/aliases.json

provides:
  - name: openbao
    type: cluster

consumes:
  - name: openbao
    type: cluster

properties:
  openbao.port:
    description: TCP port to bind OpenBao on.
    default: 443

  openbao.tls.certificate:
    description: TLS certificate for securing communication with clients.

  openbao.tls.key:
    description: TLS private key for securing communication with clients.

  openbao.peer.tls.ca:
    description: |
      TLS CA certificate for verifying peer-to-peer Raft communication.
      If not provided, a self-signed certificate will be automatically generated.

  openbao.peer.tls.certificate:
    description: |
      TLS certificate for peer-to-peer Raft communication.
      If not provided, a self-signed certificate will be automatically generated.

  openbao.peer.tls.key:
    description: |
      TLS private key for peer-to-peer Raft communication.
      If not provided, a self-signed certificate will be automatically generated.

  openbao.peer.tls.use_self_signed_certs:
    description: Indicate whether we generate self-signed peer certificates.
    default: false

  openbao.peer.tls.servername:
    description: |
      TLS server name presented when verifying the certificate seen during
      Raft retry_join. leader_api_addr dials the leader's API port, which
      presents the vault serving certificate (openbao.tls.certificate), not
      the raft peer certificate, so this must match a SAN on the vault
      serving cert rather than the peer cert. It cannot be a per-instance
      BOSH-DNS name or IP, since the shared serving certificate can never
      carry those. The kit issues vault serving certs with the SAN
      "openbao.bosh", which is the default. Blocs whose already-deployed
      serving certificate carries a different SAN must override this to
      match that SAN, or rotate the serving certificate to carry
      "openbao.bosh".
    default: "openbao.bosh"

  openbao.raft.node_id:
    description: |
      Stable Raft node_id for this instance. Defaults to the BOSH instance
      id (spec.id). That default is only safe for director-managed
      deployments: a `bosh create-env` VM recreate assigns a NEW instance
      id, orphaning the persisted Raft voter list, so the node unseals but
      can never win an election again (reads work, writes fail). create-env
      deployments should pin this to a value that survives VM recreation,
      e.g. "<deployment>-openbao". Changing it on a node with existing Raft
      data requires a peers.json recovery election override.
    default: ""

  openbao.ui:
    description: If set to true, the OpenBao UI will be enabled.
    default: false

  openbao.log_level:
    description: "Log level: trace, debug, info, warn, error."
    default: "info"

  openbao.default_lease_ttl:
    description: Default lease TTL for tokens and secrets.
    default: "768h"

  openbao.max_lease_ttl:
    description: Maximum lease TTL for tokens and secrets.
    default: "768h"

  openbao.disable_standby_reads:
    description: |
      When true, standby nodes forward every request, reads included, to the
      active node, so a read always observes the write before it. When false,
      standby nodes answer read-only requests from their own copy of the Raft
      data, which lags the active node, and a read that follows a write can
      return the previous value unless the client sends X-Vault-Index with an
      X-Vault-Inconsistent fallback. safe and Genesis send neither header and
      update a secret by reading it, merging a key, and writing the whole
      secret back, so a stale read there silently drops keys. OpenBao itself
      defaults this to false; this release defaults it to true. Changes take
      effect when the job restarts. Accepts true or false, as a boolean or a
      string; any other value fails the render.
    default: true

  openbao.seal.type:
    description: |
      How OpenBao is unsealed. "static" unseals automatically from a key
      file rendered into the job directory, and the render fails closed when
      no key is given. "shamir" keeps manual unsealing with Shamir shares and
      renders no seal stanza. Any other value fails the render. Existing
      Shamir deployments must set this to "shamir" when they upgrade to
      0.4.0; adding a static key to an already initialized Shamir cluster
      starts a seal migration, which the README describes.
    default: static

  openbao.seal.static.current_key:
    description: |
      Current static seal key, as 64 hex characters or as 44 base64
      characters that decode to 32 bytes. Raw 32-byte keys are rejected,
      because the key file is read with surrounding whitespace trimmed.
      Required when openbao.seal.type is static.

  openbao.seal.static.current_key_id:
    description: |
      Optional identifier stored with every blob the current key encrypts.
      When empty, the id is derived as "sha256-" followed by the first 16
      hex characters of the SHA-256 of the decoded key bytes. That scheme is
      frozen once shipped, because stored blobs carry the id.
    default: ""

  openbao.seal.static.previous_key:
    description: |
      Previous static seal key, in the same formats as current_key. Set only
      during rotation, together with previous_key_id.

  openbao.seal.static.previous_key_id:
    description: |
      Identifier of the previous key. Required whenever previous_key is set,
      and rejected when previous_key is empty.
    default: ""

  openbao.seal.static.disabled:
    description: |
      When true, the static stanza renders disabled = "true", which is how
      OpenBao migrates from a static seal back to Shamir. Accepts true or
      false, as a boolean or a string.
    default: false
